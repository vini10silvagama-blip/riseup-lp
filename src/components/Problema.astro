---
// 2. O problema real — onde o faturamento vaza (DOR)
import { problema } from '../content/conteudo';
---

<section class="bg-cinza-claro py-16 md:py-24" aria-labelledby="titulo-problema">
  <!-- Computador: texto fixo à esquerda (5/12) e jornada à direita (7/12) · Celular: uma coluna -->
  <div class="container-lp grid items-start gap-12 lg:grid-cols-12 lg:gap-[72px]">
    <div class="lg:sticky lg:top-[120px] lg:col-span-5" data-revelar>
      <p class="sobretitulo text-sm!">{problema.sobretitulo}</p>
      <h2 id="titulo-problema" class="titulo-secao mt-4 text-balance">{problema.titulo}</h2>
      <p class="mt-5 text-lg leading-[1.55] text-cinza-texto">{problema.subtitulo}</p>
      <a
        href={problema.link.href}
        class="mt-7 inline-flex min-h-11 items-center text-base font-semibold text-preto underline decoration-1 underline-offset-[6px] transition-colors duration-200 hover:text-ciano-escuro"
      >
        {problema.link.texto}
      </a>
    </div>

    <div class="lg:col-span-7">
      <h3 class="mb-2 font-texto text-[15px] font-semibold text-cinza-texto">{problema.jornadaTitulo}</h3>
      <ol data-revelar-filhos>
        {
          problema.etapas.map((etapa, i) => (
            <li class="grid grid-cols-[36px_1fr] gap-x-4 border-b border-borda py-[18px] last:border-b-0">
              <span
                class="row-span-2 flex size-9 items-center justify-center rounded-full border-[1.5px] border-ciano bg-branco text-[15px] font-semibold text-preto"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <span class="self-center text-[17px] leading-snug font-semibold text-preto">{etapa.nome}</span>
              <span class="mt-1 text-base leading-[1.5] text-cinza-texto">{etapa.texto}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
