---
// 11. FAQ em acordeão (primeira pergunta aberta)
import { faq } from '../content/conteudo';
import Divisor from './ui/Divisor.astro';
import Icone from './ui/Icone.astro';
---

<section class="secao bg-branco" aria-labelledby="titulo-faq">
  <div class="container-lp flex flex-col items-center gap-10">
    <div class="flex max-w-[900px] flex-col items-center gap-3 text-center" data-revelar>
      <Divisor icone="pergunta" />
      <p class="text-[15px] font-bold text-ciano-escuro md:text-base">{faq.sobretitulo}</p>
      <h2 id="titulo-faq" class="text-[30px] leading-[1.18] tracking-[-0.02em] md:text-[42px]">{faq.titulo}</h2>
    </div>

    <div class="flex w-full max-w-[880px] flex-col gap-2.5" data-revelar-filhos>
      {
        faq.perguntas.map((item, i) => (
          <details class="acordeao group rounded-[14px] border border-transparent bg-cinza-claro transition-[background-color,border-color] duration-300 open:border-ciano/40 open:bg-ciano-suave" name="faq" open={i === 0}>
            <summary class="flex min-h-[60px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-base font-bold md:px-6 md:text-[17px] [&::-webkit-details-marker]:hidden">
              {item.q}
              <Icone
                nome="mais"
                class="size-[22px] shrink-0 text-ciano-escuro transition-transform duration-300 ease-suave group-open:rotate-45"
                espessura={2}
              />
            </summary>
            <p class="px-5 pb-5 text-[15px] leading-[1.55] text-cinza-texto md:px-6 md:pb-[22px] md:text-base">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Mantém só uma pergunta aberta por vez (para navegadores sem suporte ao atributo "name")
  const itens = document.querySelectorAll<HTMLDetailsElement>('details.acordeao');
  itens.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) itens.forEach((outro) => outro !== d && (outro.open = false));
    }),
  );
</script>

<style>
  /* Abertura suave onde o navegador suporta */
  @supports (interpolate-size: allow-keywords) {
    .acordeao {
      interpolate-size: allow-keywords;
    }
    .acordeao::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        content-visibility 0.35s allow-discrete;
    }
    .acordeao[open]::details-content {
      block-size: auto;
    }
  }
</style>
