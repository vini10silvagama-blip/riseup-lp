---
// Ícones em traço (stroke). Uso: <Icone nome="alvo" class="size-6" />
interface Props {
  nome:
    | 'estrela'
    | 'alvo'
    | 'conversao'
    | 'grafico'
    | 'gota'
    | 'escudo'
    | 'check'
    | 'x'
    | 'seta'
    | 'seta-esquerda'
    | 'chevron-esquerda'
    | 'chevron-direita'
    | 'play'
    | 'menu'
    | 'fechar'
    | 'mais'
    | 'instagram'
    | 'lupa'
    | 'pilar'
    | 'foguete'
    | 'pergunta'
    | 'filtro'
    | 'pausa'
    | 'brilho'
    | 'mensagem'
    | 'lista-check'
    | 'organograma';
  class?: string;
  espessura?: number;
}

const { nome, class: classe = 'size-5', espessura = 1.8 } = Astro.props;
---

<svg
  class={classe}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={espessura}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nome === 'estrela' && <path d="M12 2l3 6.5 7 .8-5.2 4.8 1.4 7L12 17.8 5.8 21.1l1.4-7L2 9.3l7-.8z" />}
  {
    nome === 'alvo' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="5" />
        <circle cx="12" cy="12" r="1.5" />
      </>
    )
  }
  {
    nome === 'conversao' && (
      <>
        <path d="M17 2l4 4-4 4" />
        <path d="M3 11V9a3 3 0 013-3h15" />
        <path d="M7 22l-4-4 4-4" />
        <path d="M21 13v2a3 3 0 01-3 3H3" />
      </>
    )
  }
  {
    nome === 'grafico' && (
      <>
        <path d="M3 3v18h18" />
        <path d="M7 15v2" />
        <path d="M12 10v7" />
        <path d="M17 6v11" />
      </>
    )
  }
  {nome === 'gota' && <path d="M12 2.5S5 10.6 5 15a7 7 0 0014 0c0-4.4-7-12.5-7-12.5z" />}
  {
    nome === 'escudo' && (
      <>
        <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" />
        <path d="M9 12l2 2 4-4" />
      </>
    )
  }
  {nome === 'check' && <path d="M20 6L9 17l-5-5" />}
  {nome === 'x' && <path d="M18 6L6 18M6 6l12 12" />}
  {nome === 'seta' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nome === 'seta-esquerda' && <path d="M19 12H5M11 18l-6-6 6-6" />}
  {nome === 'chevron-esquerda' && <path d="M15 18l-6-6 6-6" />}
  {nome === 'chevron-direita' && <path d="M9 18l6-6-6-6" />}
  {nome === 'play' && <path d="M8 5v14l11-7z" fill="currentColor" />}
  {nome === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nome === 'fechar' && <path d="M18 6L6 18M6 6l12 12" />}
  {nome === 'mais' && <path d="M12 5v14M5 12h14" />}
  {
    nome === 'lupa' && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="M20 20l-3.5-3.5" />
      </>
    )
  }
  {
    nome === 'pilar' && (
      <>
        <path d="M3 21h18M4 7h16M12 3l8 4H4z" />
        <path d="M6 7v11M10 7v11M14 7v11M18 7v11M4 18h16" />
      </>
    )
  }
  {
    nome === 'foguete' && (
      <>
        <path d="M5 15c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.1 2.1 0 00-2.9-.1z" />
        <path d="M12 15l-3-3a22 22 0 012-4A12.9 12.9 0 0122 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 01-4 2z" />
        <path d="M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5" />
      </>
    )
  }
  {
    nome === 'pergunta' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M9.1 9a3 3 0 015.8 1c0 2-3 3-3 3M12 17h.01" />
      </>
    )
  }
  {nome === 'filtro' && <path d="M3 4h18l-7 8.5V19l-4 2v-8.5z" />}
  {nome === 'pausa' && <path d="M9 5v14M15 5v14" />}
  {
    nome === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    nome === 'brilho' && (
      <>
        <path d="M10 3l1.6 4.4L16 9l-4.4 1.6L10 15l-1.6-4.4L4 9l4.4-1.6z" />
        <path d="M18 13l.8 2.2L21 16l-2.2.8L18 19l-.8-2.2L15 16l2.2-.8z" />
        <path d="M18 3v3M16.5 4.5h3" />
      </>
    )
  }
  {nome === 'mensagem' && <path d="M21 12a8 8 0 01-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1121 12z" />}
  {
    nome === 'lista-check' && (
      <>
        <path d="M3.5 6.5l1.5 1.5 3-3M3.5 12.5l1.5 1.5 3-3M3.5 18.5l1.5 1.5 3-3" />
        <path d="M11 7h10M11 13h10M11 19h10" />
      </>
    )
  }
  {
    nome === 'organograma' && (
      <>
        <rect x="9" y="3" width="6" height="5" rx="1.2" />
        <rect x="3" y="16" width="6" height="5" rx="1.2" />
        <rect x="15" y="16" width="6" height="5" rx="1.2" />
        <path d="M12 8v4M6 16v-2a2 2 0 012-2h8a2 2 0 012 2v2" />
      </>
    )
  }
</svg>
