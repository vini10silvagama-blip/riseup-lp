---
// 3. O que fazemos pela sua clínica — âncora "Sobre" (ponte DOR → SOLUÇÃO)
import { oQueFazemos } from '../content/conteudo';
import Cabecalho from './ui/Cabecalho.astro';
import Destaque from './ui/Destaque.astro';
---

<section id="sobre" class="secao bg-branco" aria-labelledby="titulo-sobre">
  <div class="container-lp flex flex-col gap-10">
    <Cabecalho id="titulo-sobre" icone="lupa" sobretitulo={oQueFazemos.sobretitulo} titulo={oQueFazemos.titulo} />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5" data-revelar-filhos>
      {
        oQueFazemos.cards.map((card) => (
          <li class="group card-hover flex flex-col gap-3.5 rounded-card bg-cinza-claro p-6 md:p-7">
            <p class="text-[15px] text-cinza-texto italic">{card.dor}</p>
            <span class="h-[3px] w-8 bg-ciano origin-left transition-[scale] duration-300 ease-suave group-hover:scale-x-[1.75]" aria-hidden="true" />
            <p class="text-[17px] leading-[1.4] font-bold">{card.solucao}</p>
          </li>
        ))
      }
    </ul>

    <p
      class="rounded-card bg-linear-to-br from-preto to-[#1E2020] px-6 py-8 text-center font-titulo text-xl leading-[1.45] text-branco md:px-10 md:text-[23px]"
      data-revelar
    >
      <Destaque texto={oQueFazemos.manifesto} cor="font-medium text-ciano" />
    </p>
  </div>
</section>
