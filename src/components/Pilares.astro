---
// 4. Pilares — âncora "Soluções" (SOLUÇÃO)
import { pilares } from '../content/conteudo';
import Cabecalho from './ui/Cabecalho.astro';
import Icone from './ui/Icone.astro';
import Tag from './ui/Tag.astro';
---

<section id="solucoes" class="secao bg-cinza-claro" aria-labelledby="titulo-solucoes">
  <div class="container-lp flex flex-col gap-12 md:gap-14">
    <Cabecalho id="titulo-solucoes" icone="pilar" sobretitulo={pilares.sobretitulo} titulo={pilares.titulo} subtitulo={pilares.subtitulo} />

    <!-- Etiquetas "Pilar N" na borda de cima dos cards, ligadas por uma linha
         (horizontal no computador, vertical à esquerda no celular) -->
    <ul class="pilares relative grid gap-9 pt-4 pl-7 sm:grid-cols-2 sm:gap-x-4 lg:grid-cols-4 lg:gap-5 lg:pl-0" data-revelar-filhos>
      {
        pilares.itens.map((pilar, i) => (
          <li
            class:list={[
              'pilar card-hover relative flex flex-col gap-4 rounded-card border-2 bg-branco p-6 pt-8 md:p-7 md:pt-9',
              pilar.destaque ? 'brilho border-ciano' : 'border-transparent',
            ]}
          >
            <span class="absolute -top-4 left-5 z-[2] rounded-pilula bg-ciano px-3.5 py-1.5 text-[13px] font-bold md:left-6">
              {pilares.rotuloPilar} {i + 1}
            </span>
            <span class="flex size-[52px] items-center justify-center rounded-[14px] bg-ciano-suave text-ciano-escuro">
              <Icone nome={pilar.icone as 'estrela'} class="size-[26px]" />
            </span>
            <h3 class="font-texto text-sm font-bold tracking-[0.06em] text-ciano-escuro uppercase">{pilar.nome}</h3>
            <p class="font-titulo text-xl leading-[1.35] font-medium">{pilar.frase}</p>

            {pilar.destaque && (
              <div class="flex flex-col gap-1.5 rounded-xl bg-ciano-suave p-3">
                <a
                  href={pilar.destaque.href}
                  class="group inline-flex min-h-9 items-center gap-1.5 self-start rounded-pilula bg-ciano px-3.5 text-[13px] font-bold text-preto transition-shadow hover:shadow-[var(--shadow-brilho-forte)]"
                >
                  {pilar.destaque.botao}
                  <Icone nome="seta" class="size-4 transition-transform group-hover:translate-x-0.5" espessura={2.2} />
                </a>
                <p class="text-xs leading-[1.4] text-cinza-texto">{pilar.destaque.texto}</p>
              </div>
            )}

            <ul class="flex flex-wrap gap-1.5" aria-label="Serviços">
              {pilar.tags.map((tag) => (
                <li>
                  <Tag>{tag}</Tag>
                </li>
              ))}
            </ul>

            <p class="mt-auto rounded-xl bg-preto p-4 text-sm leading-[1.45] text-branco">
              <strong class="text-ciano">{pilares.rotuloPrevisibilidade}</strong> {pilar.previsibilidade}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Linha que liga as etiquetas: vertical à esquerda no celular */
  .pilares::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 10px;
    top: 16px;
    bottom: 24px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--color-ciano), var(--color-ciano-escuro));
    transform-origin: top;
  }
  /* Ponto na linha na altura de cada etiqueta */
  .pilar::before {
    content: '';
    position: absolute;
    top: -6px;
    left: -23px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-ciano);
    box-shadow: 0 0 0 4px var(--color-cinza-claro);
  }
  @media (min-width: 640px) {
    .pilares::before,
    .pilar::before {
      display: none;
    }
  }
  /* Computador: linha horizontal atravessando os 4 cards na altura das etiquetas */
  @media (min-width: 1024px) {
    .pilares::before {
      display: block;
      left: 0;
      right: 0;
      top: 15px;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(to right, var(--color-ciano), var(--color-ciano-escuro));
      box-shadow: 0 0 12px rgba(41, 217, 213, 0.5);
      transform-origin: left;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .pilares::before {
      scale: 1 0;
      transition: scale 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s;
    }
    @media (min-width: 1024px) {
      :global(.js) .pilares::before {
        scale: 0 1;
      }
    }
    .pilares:global(.visivel)::before {
      scale: 1 1;
    }
  }
</style>
