---
// 1. Hero — promessa
import fs from 'node:fs';
import path from 'node:path';
import { hero } from '../content/conteudo';
import Botao from './ui/Botao.astro';
import Icone from './ui/Icone.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Arquivos = Record<string, { default: ImageMetadata }>;
const nomeDoArquivo = (caminho: string) => caminho.split('/').pop()!.replace(/\.[^.]+$/, '');

// Fotos dos sócios (src/assets/socios/), achadas pelo campo "foto" do conteúdo
const fotos: Arquivos = import.meta.glob('../assets/socios/*.{png,jpg,jpeg,webp}', { eager: true });
const fotoDe = (nome: string) => Object.entries(fotos).find(([caminho]) => nomeDoArquivo(caminho) === nome)?.[1].default;

// Enquadramento das fotos: os olhos ficam a 38% da altura do cartão e os dois rostos no mesmo
// tamanho (mesma distância entre as pupilas). Posição das pupilas medida em cada arquivo
// (fração da largura e da altura da foto). Se trocar uma foto, meça e atualize aqui.
const PROPORCAO_FOTO = 1800 / 1200; // altura ÷ largura dos arquivos
const ALTURA_OLHOS = 0.38;
const pupilas: Record<string, { esquerda: number[]; direita: number[] }> = {
  vinicius: { esquerda: [0.4, 0.448], direita: [0.605, 0.457] },
  felipe: { esquerda: [0.423, 0.403], direita: [0.61, 0.427] },
};
// Devolve largura, esquerda e topo da foto (em %) para um cartão de proporção altura ÷ largura
const enquadrar = (proporcaoCartao: number) => {
  const dados = Object.entries(pupilas).map(([nome, { esquerda, direita }]) => {
    const x = (esquerda[0] + direita[0]) / 2;
    const y = (esquerda[1] + direita[1]) / 2;
    const distancia = Math.hypot(direita[0] - esquerda[0], (direita[1] - esquerda[1]) * PROPORCAO_FOTO);
    // menor ampliação que ainda cobre o cartão inteiro com os olhos no lugar
    const minima = Math.max(
      0.5 / x,
      0.5 / (1 - x),
      (ALTURA_OLHOS * proporcaoCartao) / (PROPORCAO_FOTO * y),
      ((1 - ALTURA_OLHOS) * proporcaoCartao) / (PROPORCAO_FOTO * (1 - y)),
    );
    return { nome, x, y, distancia, minima };
  });
  const distanciaFinal = Math.max(...dados.map((f) => f.minima * f.distancia)) * 1.02;
  return Object.fromEntries(
    dados.map((f) => {
      const escala = distanciaFinal / f.distancia;
      return [
        f.nome,
        {
          largura: `${(escala * 100).toFixed(2)}%`,
          esquerda: `${((0.5 - f.x * escala) * 100).toFixed(2)}%`,
          topo: `${(((ALTURA_OLHOS * proporcaoCartao - f.y * PROPORCAO_FOTO * escala) / proporcaoCartao) * 100).toFixed(2)}%`,
        },
      ];
    }),
  );
};
const quadros = {
  celular: enquadrar(4 / 3), // cartões 3:4 abaixo de 1024px
  medio: enquadrar(310 / 232), // 1024–1279px
  grande: enquadrar(384 / 268), // a partir de 1280px
};

// Título: o "\n" do conteúdo vira quebra de linha só no computador
const linhasTitulo = hero.titulo.antes.split('\n');
// "R$" e números nunca ficam sozinhos no fim da linha ("R$ 115", "3 meses")
const semQuebraNoValor = (texto: string) => texto.replace(/(R\$|\d) /g, '$1 ');

// Logos de clientes: lidos de public/img/clientes/ na hora do build (SVG ou PNG, até 10), em ordem
// alfabética do nome do arquivo. O texto alternativo vem do nome, sem o número inicial e com hífens
// virando espaços: "01-clinica-sorriso.svg" → "Clinica Sorriso"; nomes com maiúsculas/acentos ficam como estão.
const pastaLogos = path.join(process.cwd(), 'public', 'img', 'clientes');
const arquivosLogos = fs.existsSync(pastaLogos)
  ? fs
      .readdirSync(pastaLogos)
      .filter((a) => /\.(svg|png)$/i.test(a))
      .sort((a, b) => a.localeCompare(b, 'pt-BR', { numeric: true }))
      .slice(0, 10)
  : [];
// Largura e altura reais, para o navegador reservar o espaço antes de carregar
const medidas = (arquivo: string) => {
  const conteudo = fs.readFileSync(path.join(pastaLogos, arquivo));
  if (/\.png$/i.test(arquivo)) return { largura: conteudo.readUInt32BE(16), altura: conteudo.readUInt32BE(20) };
  const caixa = conteudo.toString('utf8').match(/viewBox=["'][\d.\-]+[\s,]+[\d.\-]+[\s,]+([\d.]+)[\s,]+([\d.]+)/);
  return caixa ? { largura: Math.round(+caixa[1]), altura: Math.round(+caixa[2]) } : {};
};
const logos = arquivosLogos.map((arquivo) => {
  const nome = nomeDoArquivo(arquivo)
    .replace(/^\d+[\s._-]*/, '')
    .replace(/[-_]+/g, ' ')
    .trim();
  const alt = nome === nome.toLowerCase() ? nome.replace(/(^|\s)\S/g, (l) => l.toUpperCase()) : nome;
  return { src: `/img/clientes/${encodeURIComponent(arquivo)}`, alt, ...medidas(arquivo) };
});
// Posições do carrossel: os logos reais primeiro; com menos de 6, os marcadores completam
const posicoes = Array.from({ length: Math.max(hero.clientes.length, logos.length) }, (_, i) => logos[i] ?? hero.clientes[i]);
---

<!-- Topo: 72px abaixo do cabeçalho fixo (72px de cabeçalho no celular, 88px a partir de 768px) -->
<section id="inicio" class="relative isolate overflow-x-clip pt-[104px] pb-[72px] md:pt-[136px] lg:pt-[160px]" aria-labelledby="titulo-hero">
  <!-- Brilho discreto no canto superior esquerdo (decorativo) -->
  <div class="brilho-canto pointer-events-none absolute -top-24 -left-28 -z-10 size-[380px] rounded-full bg-ciano/8 blur-[80px]" aria-hidden="true"></div>

  <div class="container-lp">
    <div
      class="grid items-center gap-12 lg:grid-cols-[minmax(0,600px)_440px] lg:justify-between lg:gap-x-12 xl:grid-cols-[610px_minmax(0,1fr)] xl:gap-x-10"
    >
      <!-- Texto: tudo na mesma borda esquerda (acima dos efeitos de fundo) -->
      <div class="entrada @container relative z-10 flex flex-col items-start">
        <p class="rounded-pilula border border-borda bg-branco/70 px-3.5 py-1.5 text-xs font-medium md:text-[13px]">{hero.etiqueta}</p>
        <h1 id="titulo-hero" class="titulo-hero mt-6 text-[34px] leading-[1.12] tracking-[-0.025em] text-balance">
          {
            linhasTitulo.map((linha, i) => (
              <>
                {linha}
                {i < linhasTitulo.length - 1 && <br class="hidden lg:block" />}
              </>
            ))
          }<br class="hidden lg:block" /><span class="text-ciano-escuro">{hero.titulo.destaque}</span>
        </h1>
        <p class="mt-6 max-w-[500px] text-[17px] leading-[1.6] text-cinza-texto lg:text-lg">{hero.subtitulo}</p>
        <div class="mt-8 flex w-full flex-col gap-3 lg:w-auto lg:flex-row lg:items-center lg:gap-0">
          <Botao href={hero.botaoPrincipal.href} shimmerAuto class="shadow-[0_6px_18px_rgba(41,217,213,0.28)]!">{hero.botaoPrincipal.texto}</Botao>
          <!-- Secundário como link de texto (área clicável de 44px de altura) -->
          <a
            href={hero.botaoSecundario.href}
            class="inline-flex min-h-11 items-center self-center text-base font-semibold text-preto underline decoration-[1.5px] underline-offset-[6px] transition-colors duration-200 hover:text-ciano-escuro lg:ml-7"
          >
            {hero.botaoSecundario.texto}
          </a>
        </div>
        <p class="mt-4 flex items-center gap-2 text-sm text-cinza-texto">
          <Icone nome="check" class="size-4 shrink-0 text-ciano-escuro" espessura={2} />
          {hero.notaBotao}
        </p>
      </div>

      <!-- Fotos: lado a lado no celular/tablet; escalonadas a partir de 1024px
           (bloco de 440×420 até 1279px; 510×514 a partir de 1280px, avançando 40px além do container) -->
      <div
        class="entrada entrada-2 relative isolate mx-auto w-full max-w-[560px] pt-10 lg:mx-0 lg:h-[420px] lg:w-[440px] lg:max-w-none lg:pt-0 xl:-mr-10 xl:h-[514px] xl:w-[510px]"
      >
        <!-- Fundo com movimento (decorativo): brilho que se desloca e três anéis em onda,
             centralizados nas fotos. Só transform e opacity. -->
        <div class="pointer-events-none absolute inset-x-0 top-10 -z-10 h-0 pb-[64%] lg:inset-0 lg:h-auto lg:pb-0" aria-hidden="true">
          <div class="brilho-fotos absolute top-1/2 left-1/2 size-[340px] rounded-full bg-ciano/16 blur-[60px] lg:size-[460px]"></div>
          <div class="onda absolute top-1/2 left-1/2 size-[340px] rounded-full border border-ciano lg:size-[520px]"></div>
          <div class="onda onda-2 absolute top-1/2 left-1/2 size-[340px] rounded-full border border-ciano lg:size-[520px]"></div>
          <div class="onda onda-3 absolute top-1/2 left-1/2 size-[340px] rounded-full border border-ciano lg:size-[520px]"></div>
        </div>

        <!-- O cartão B fica por cima do A, com contorno branco de 6px do lado da sobreposição -->
        <div class="flex justify-between lg:block">
          {
            hero.socios.map((socio, i) => {
              const foto = fotoDe(socio.foto);
              // Variáveis de enquadramento por faixa de largura (usadas em .foto-socio)
              const variaveis = (
                [
                  ['', quadros.celular],
                  ['-lg', quadros.medio],
                  ['-xl', quadros.grande],
                ] as const
              )
                .map(([s, q]) => {
                  const f = q[socio.foto];
                  return f ? `--largura${s}:${f.largura};--esquerda${s}:${f.esquerda};--topo${s}:${f.topo}` : '';
                })
                .join(';');
              const cartao = (
                <div class="relative aspect-[3/4] w-full overflow-hidden rounded-[20px] bg-cinza-claro lg:aspect-auto lg:h-[310px] lg:w-[232px] xl:h-[384px] xl:w-[268px]">
                  {foto && (
                    <Image
                      src={foto}
                      alt={socio.alt}
                      widths={[400, 800]}
                      format="webp"
                      sizes="(min-width:1280px) 320px, (min-width:1024px) 275px, 56vw"
                      loading="eager"
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                      class="foto-socio absolute h-auto max-w-none"
                      style={variaveis}
                    />
                  )}
                  <!-- Nome e cargo na base da foto, sobre degradê escuro -->
                  <div class="absolute inset-x-0 bottom-0 flex h-24 flex-col justify-end bg-linear-to-t from-[rgba(20,20,20,0.75)] to-transparent p-3 text-branco sm:p-4">
                    <p class="text-[15px] leading-tight font-semibold xl:text-base">{socio.nome}</p>
                    <p class="mt-0.5 truncate text-[13px] text-branco/90 xl:text-[13.5px]">{socio.funcao}</p>
                  </div>
                </div>
              );
              return i === 0 ? (
                <div class="w-[48%] lg:absolute lg:top-0 lg:left-0 lg:w-auto">{cartao}</div>
              ) : (
                <div class="w-[48%] lg:absolute lg:right-0 lg:bottom-0 lg:z-10 lg:w-auto lg:rounded-[26px] lg:bg-branco lg:pt-1.5 lg:pl-1.5">{cartao}</div>
              );
            })
          }
        </div>

        <!-- Selo (decorativo): na divisa das fotos no celular; no canto superior direito do bloco no computador -->
        <div
          class="selo absolute top-10 left-1/2 z-20 size-20 -translate-x-1/2 -translate-y-1/2 rounded-full bg-preto shadow-[0_10px_28px_rgba(20,20,20,0.18)] lg:top-0 lg:right-6 lg:left-auto lg:size-[92px] lg:translate-x-0 lg:translate-y-0 xl:top-10 xl:right-auto xl:left-[262px] xl:size-[104px]"
          aria-hidden="true"
        >
          <svg viewBox="0 0 104 104" class="absolute inset-0 size-full">
            <defs>
              <!-- Arco de cima passa por cima do círculo; o de baixo vai da esquerda para a direita por baixo -->
              <path id="selo-arco-cima" d="M31.5,87.51 A41,41 0 1,1 72.5,87.51"></path>
              <path id="selo-arco-baixo" d="M6.42,68.59 A48.5,48.5 0 0,0 97.58,68.59"></path>
            </defs>
            <text class="fill-branco font-semibold" font-size="10.5" letter-spacing="2" text-anchor="middle">
              <textPath href="#selo-arco-cima" startOffset="50%">{hero.selo.arcoCima}</textPath>
            </text>
            <text class="fill-branco font-semibold" font-size="10.5" letter-spacing="2" text-anchor="middle">
              <textPath href="#selo-arco-baixo" startOffset="50%">{hero.selo.arcoBaixo}</textPath>
            </text>
          </svg>
          <img src="/img/dente-ciano.png" alt="" width="160" height="160" class="absolute top-1/2 left-1/2 size-[30%] -translate-x-1/2 -translate-y-1/2" />
        </div>

        <!-- Cartão do case: abaixo das fotos no celular; no canto abaixo do cartão A no computador
             (entre 1024 e 1279px, letra e padding um pouco menores para não encostar no cartão B) -->
        <div
          class="cartao-case mt-4 rounded-[14px] bg-preto px-[18px] py-3.5 text-branco shadow-[0_12px_30px_rgba(20,20,20,0.2)] lg:absolute lg:bottom-0 lg:left-0 lg:mt-0 lg:max-w-[226px] lg:px-3 lg:py-3 xl:top-[400px] xl:bottom-auto xl:px-[18px] xl:py-3.5"
        >
          <p class="text-sm leading-snug font-semibold whitespace-nowrap tabular-nums lg:text-[13px] xl:text-sm" data-contar>{semQuebraNoValor(hero.cardCase.titulo)}</p>
          <p class="mt-0.5 text-[12.5px] leading-snug whitespace-nowrap text-branco/75 lg:text-[11.5px] xl:text-[12.5px]">{semQuebraNoValor(hero.cardCase.texto)}</p>
        </div>
      </div>
    </div>

    <!-- Logos de clientes em carrossel contínuo (decorativo, pausável). Cada posição mostra o logo real
         de public/img/clientes/ (em cinza) ou, sem arquivo, o marcador provisório. -->
    <div class="mt-14 flex flex-col gap-4" data-revelar>
      <div class="flex items-center justify-between gap-3">
        <p class="text-[13px] font-medium text-cinza-texto">{hero.clientesTitulo}</p>
        <button
          type="button"
          id="pausar-logos"
          class="botao-pausa group inline-flex size-10 items-center justify-center rounded-full border border-borda text-preto"
          aria-pressed="false"
          aria-label="Pausar a faixa de logos"
        >
          <Icone nome="pausa" class="size-4 group-aria-pressed:hidden" espessura={2.2} />
          <Icone nome="play" class="hidden size-4 group-aria-pressed:block" />
        </button>
      </div>
      <!-- tabindex: pelo teclado, o foco na faixa também pausa (e permite rolar com animações reduzidas) -->
      <div class="faixa-logos" style={`--quantidade: ${posicoes.length}`} tabindex="0" role="region" aria-label={hero.clientesTitulo}>
        <div class="trilho-logos flex w-max">
          {
            [0, 1].map((copia) => (
              <ul class:list={['lista-logos flex', copia === 1 && 'copia-logos']} aria-hidden={copia === 1 ? 'true' : undefined}>
                {posicoes.map((posicao) =>
                  typeof posicao === 'string' ? (
                    <li class="logo-cliente caixa-logo flex h-16 shrink-0 items-center justify-center rounded-xl border-[1.5px] border-dashed border-[#C9D3D3] px-2 text-center text-xs text-cinza-texto">
                      {posicao}
                    </li>
                  ) : (
                    <li class="logo-cliente caixa-logo flex h-16 shrink-0 items-center justify-center px-3">
                      <img
                        src={posicao.src}
                        alt={copia === 1 ? '' : posicao.alt}
                        width={posicao.largura}
                        height={posicao.altura}
                        loading="lazy"
                        decoding="async"
                        class="h-auto max-h-10 w-auto max-w-full object-contain"
                      />
                    </li>
                  ),
                )}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Enquadramento de cada foto (valores calculados no topo do arquivo, por faixa de largura) */
  .foto-socio {
    width: var(--largura);
    left: var(--esquerda);
    top: var(--topo);
  }
  @media (min-width: 1024px) {
    .foto-socio {
      width: var(--largura-lg);
      left: var(--esquerda-lg);
      top: var(--topo-lg);
    }
  }
  @media (min-width: 1280px) {
    .foto-socio {
      width: var(--largura-xl);
      left: var(--esquerda-xl);
      top: var(--topo-xl);
    }
  }

  /* Título: 34px com quebra automática no celular/tablet. A partir de 1024px, exatamente 3 linhas
     (quebras pelo <br>): encolhe junto com a coluna até 1279px e fica em 46px no computador */
  @media (min-width: 1024px) {
    .titulo-hero {
      font-size: min(46px, calc(100cqi / 13.8));
      white-space: nowrap;
    }
  }
  @media (min-width: 1280px) {
    .titulo-hero {
      font-size: 46px;
    }
  }

  /* Fundo com movimento. Os anéis somem (opacidade 0) antes de chegar à coluna de texto. */
  .brilho-fotos,
  .onda {
    transform: translate(-50%, -50%);
  }
  .onda {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .brilho-fotos {
      animation: brilho-fotos 14s ease-in-out infinite alternate;
    }
    .brilho-canto {
      animation: brilho-canto 20s ease-in-out infinite alternate;
    }
    .onda {
      animation: onda 9s linear infinite;
    }
    .onda-2 {
      animation-delay: 3s;
    }
    .onda-3 {
      animation-delay: 6s;
    }
  }
  @keyframes brilho-fotos {
    to {
      transform: translate(calc(-50% + 24px), calc(-50% - 16px)) scale(1.08);
    }
  }
  @keyframes brilho-canto {
    to {
      transform: translate(48px, 32px) scale(1.06);
    }
  }
  @keyframes onda {
    0% {
      transform: translate(-50%, -50%) scale(0.55);
      opacity: 0.45;
    }
    65% {
      opacity: 0;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.25);
      opacity: 0;
    }
  }
  /* Animações reduzidas: brilhos parados e um único anel estático */
  @media (prefers-reduced-motion: reduce) {
    .onda {
      opacity: 0.3;
    }
    .onda-2,
    .onda-3 {
      display: none;
    }
  }

  /* Cartão do case flutua de leve só no computador (no celular fica parado, abaixo das fotos) */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .cartao-case {
      animation: flutua 6s ease-in-out infinite;
    }
    @keyframes flutua {
      0%,
      100% {
        translate: 0 0;
      }
      50% {
        translate: 0 -6px;
      }
    }
  }

  /* Carrossel de logos: 2 caixas e meia visíveis no celular, 5 no computador; bordas esmaecidas */
  .faixa-logos {
    --vao: 12px;
    --visiveis: 2.5;
    --vaos-visiveis: 2;
    container-type: inline-size;
    overflow: hidden;
    border-radius: 12px;
    mask-image: linear-gradient(to right, transparent, #000 64px, #000 calc(100% - 64px), transparent);
  }
  @media (min-width: 1024px) {
    .faixa-logos {
      --vao: 20px;
      --visiveis: 5;
      --vaos-visiveis: 4;
    }
  }
  .lista-logos {
    gap: var(--vao);
    /* o espaço depois do último logo faz as duas cópias terem a mesma largura: o loop não salta */
    padding-right: var(--vao);
  }
  .caixa-logo {
    width: calc((100cqi - var(--vaos-visiveis) * var(--vao)) / var(--visiveis));
  }
  @media (prefers-reduced-motion: no-preference) {
    .trilho-logos {
      /* cerca de 4s por logo, velocidade constante */
      animation: faixa calc(var(--quantidade) * 4s) linear infinite;
    }
    .faixa-logos:hover .trilho-logos,
    .faixa-logos:focus-within .trilho-logos,
    :global(.faixa-pausada) .trilho-logos {
      animation-play-state: paused;
    }
    @keyframes faixa {
      to {
        transform: translateX(-50%);
      }
    }
  }
  /* Animações reduzidas: nada se move; a faixa rola na horizontal manualmente */
  @media (prefers-reduced-motion: reduce) {
    .faixa-logos {
      overflow-x: auto;
      mask-image: none;
    }
    .copia-logos,
    .botao-pausa {
      display: none;
    }
  }

  /* Logos: escala de cinza e 60% de opacidade; cor e opacidade total no hover */
  .logo-cliente {
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }
  @media (hover: hover) {
    .logo-cliente:hover {
      filter: none;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .entrada {
      animation: sobe 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .entrada-2 {
      animation-delay: 0.15s;
    }
    @keyframes sobe {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
  }
</style>

<script>
  // Botão de pausa da faixa de logos
  const botaoPausa = document.getElementById('pausar-logos');
  const faixa = document.querySelector('.faixa-logos');
  if (botaoPausa && faixa) {
    botaoPausa.addEventListener('click', () => {
      const pausado = botaoPausa.getAttribute('aria-pressed') !== 'true';
      botaoPausa.setAttribute('aria-pressed', String(pausado));
      faixa.classList.toggle('faixa-pausada', pausado);
    });
  }
</script>
