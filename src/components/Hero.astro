---
// 1. Hero — promessa
import fs from 'node:fs';
import path from 'node:path';
import { hero } from '../content/conteudo';
import Botao from './ui/Botao.astro';
import Icone from './ui/Icone.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Arquivos = Record<string, { default: ImageMetadata }>;
const nomeDoArquivo = (caminho: string) => caminho.split('/').pop()!.replace(/\.[^.]+$/, '');

// Fotos dos sócios (src/assets/socios/), achadas pelo campo "foto" do conteúdo
const fotos: Arquivos = import.meta.glob('../assets/socios/*.{png,jpg,jpeg,webp}', { eager: true });
const fotoDe = (nome: string) => Object.entries(fotos).find(([caminho]) => nomeDoArquivo(caminho) === nome)?.[1].default;

// Título: o "\n" do conteúdo vira quebra de linha só no computador
const linhasTitulo = hero.titulo.antes.split('\n');

// Logos de clientes: lidos de public/img/clientes/ na hora do build (só SVG e PNG).
// O nome do arquivo vira o nome da clínica: "clinica-sorriso.png" → "Clinica Sorriso";
// nomes já com maiúsculas/acentos ficam como estão.
const pastaLogos = path.join(process.cwd(), 'public', 'img', 'clientes');
const arquivosLogos = fs.existsSync(pastaLogos) ? fs.readdirSync(pastaLogos).filter((a) => /\.(svg|png)$/i.test(a)) : [];
// Largura e altura reais, para o navegador reservar o espaço antes de carregar
const medidas = (arquivo: string) => {
  const conteudo = fs.readFileSync(path.join(pastaLogos, arquivo));
  if (/\.png$/i.test(arquivo)) return { largura: conteudo.readUInt32BE(16), altura: conteudo.readUInt32BE(20) };
  const caixa = conteudo.toString('utf8').match(/viewBox=["'][\d.\-]+[\s,]+[\d.\-]+[\s,]+([\d.]+)[\s,]+([\d.]+)/);
  return caixa ? { largura: Math.round(+caixa[1]), altura: Math.round(+caixa[2]) } : {};
};
const logos = arquivosLogos
  .map((arquivo) => {
    const nome = nomeDoArquivo(arquivo).replace(/[-_]+/g, ' ').trim();
    const alt = nome === nome.toLowerCase() ? nome.replace(/(^|\s)\S/g, (l) => l.toUpperCase()) : nome;
    return { src: `/img/clientes/${encodeURIComponent(arquivo)}`, alt, ...medidas(arquivo) };
  })
  .sort((a, b) => a.alt.localeCompare(b.alt, 'pt-BR'));
const temLogos = logos.length > 0;
// Com poucos logos a faixa não rola no celular: fica uma grade parada
const faixaRola = logos.length >= 4;
const colunas = Math.min(logos.length, 6);
---

<section id="inicio" class="relative overflow-hidden pt-[104px] pb-16 md:pt-[136px] md:pb-20" aria-labelledby="titulo-hero">
  <div class="container-lp">
    <div class="grid items-center gap-12 xl:grid-cols-[minmax(0,680px)_1fr] xl:gap-8">
      <!-- Texto -->
      <div class="entrada flex max-w-[680px] flex-col gap-6 md:gap-7">
        <p class="self-start rounded-pilula border border-borda px-3.5 py-1.5 text-xs font-medium md:text-[13px]">{hero.etiqueta}</p>
        <h1 id="titulo-hero" class="text-[38px] leading-[1.08] tracking-[-0.025em] sm:text-5xl lg:text-[48px]">
          {
            linhasTitulo.map((linha, i) => (
              <>
                {linha}
                {i < linhasTitulo.length - 1 && <br class="hidden lg:block" />}
              </>
            ))
          }<span class="text-ciano-escuro">{hero.titulo.destaque}</span>
        </h1>
        <p class="max-w-[520px] text-[17px] leading-[1.55] text-cinza-texto md:text-[19px]">{hero.subtitulo}</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-4">
          <div class="flex flex-col items-center gap-2">
            <Botao href={hero.botaoPrincipal.href} shimmerAuto class="w-full sm:w-auto">{hero.botaoPrincipal.texto}</Botao>
            <p class="text-[13px] text-cinza-texto">{hero.notaBotao}</p>
          </div>
          <Botao href={hero.botaoSecundario.href} variante="contorno">{hero.botaoSecundario.texto}</Botao>
        </div>
      </div>

      <!-- Sócios sobre círculos concêntricos -->
      <div class="entrada entrada-2 relative mx-auto w-full max-w-[520px] pb-8 xl:max-w-none">
        <div class="pointer-events-none absolute top-[48%] left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
          <div class="circulo size-[460px] border-ciano/20 sm:size-[640px] xl:size-[620px]"></div>
          <div class="circulo size-[350px] border-ciano/30 [animation-delay:-2s] sm:size-[490px] xl:size-[470px]"></div>
          <div
            class="circulo size-[250px] border-ciano/45 bg-[radial-gradient(circle,rgba(41,217,213,0.28),rgba(41,217,213,0)_70%)] [animation-delay:-4s] sm:size-[350px] xl:size-[340px]"
          >
          </div>
        </div>

        <div class="relative flex gap-2.5 sm:gap-3">
          {
            hero.socios.map((socio, i) => {
              const foto = fotoDe(socio.foto);
              return (
                <div class="relative h-[380px] flex-1 overflow-hidden rounded-[20px] border-[1.5px] border-ciano bg-cinza-claro sm:h-[420px] xl:h-[440px]">
                  {foto && (
                    <Image
                      src={foto}
                      alt={socio.alt}
                      widths={[400, 800]}
                      format="webp"
                      sizes="(min-width:1024px) 395px, 45vw"
                      loading="eager"
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                      class:list={[
                        'absolute inset-0 size-full object-cover',
                        // Rostos levemente afastados do centro, para o selo não encostar neles
                        i === 0 ? 'object-[85%_50%]' : 'object-[15%_50%]',
                      ]}
                    />
                  )}
                  <!-- Etiqueta de nome: mesma posição nas duas fotos, acima da faixa do cartão do case -->
                  <div class="absolute inset-x-2 bottom-10 rounded-xl bg-branco/95 px-3 py-2 shadow-[0_8px_24px_rgba(20,20,20,0.12)] sm:inset-x-3">
                    <p class="text-sm leading-tight font-bold">{socio.nome}</p>
                    <p class="mt-0.5 min-h-[3lh] text-[13px] leading-snug text-cinza-texto sm:min-h-[2lh]">{socio.funcao}</p>
                  </div>
                </div>
              );
            })
          }

          <!-- Selo circular no encontro das fotos, na altura dos ombros (decorativo) -->
          <div
            class="absolute top-[53%] left-1/2 size-20 -translate-x-1/2 -translate-y-1/2 rounded-full border border-ciano bg-branco shadow-[0_10px_28px_rgba(20,20,20,0.12)] sm:top-[60%] xl:top-[62%] xl:size-[104px]"
            aria-hidden="true"
          >
            <svg viewBox="0 0 100 100" class="selo-texto absolute inset-0 size-full">
              <defs>
                <path id="selo-circulo" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0"></path>
              </defs>
              <text class="fill-preto font-semibold" font-size="9.5">
                <textPath href="#selo-circulo" textLength="230" lengthAdjust="spacing">{hero.selo}</textPath>
              </text>
            </svg>
            <img src="/icon-192.png" alt="" width="192" height="192" class="absolute top-1/2 left-1/2 size-[42%] -translate-x-1/2 -translate-y-1/2" />
          </div>
        </div>

        <!-- Cartão do case: canto inferior direito, metade para fora da moldura -->
        <div
          class="flutua absolute right-0 bottom-0 flex items-center gap-2.5 rounded-[14px] bg-preto px-3.5 py-2.5 text-branco shadow-[0_12px_30px_rgba(20,20,20,0.2)] sm:-right-4 sm:px-4 xl:-right-6"
        >
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-ciano text-sm font-bold text-preto" aria-hidden="true">R$</span>
          <span>
            <span class="block text-[13px] font-bold tabular-nums" data-contar>{hero.cardCase.titulo}</span>
            <span class="block text-[13px] text-cinza-escuro-texto">{hero.cardCase.texto}</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Logos de clientes (public/img/clientes/): em cinza; no celular, faixa que rola sozinha (pausável).
         Sem nenhum arquivo na pasta, a faixa inteira não é exibida. -->
    {
      temLogos && (
        <div class="mt-14 flex flex-col gap-4 md:mt-16" data-revelar>
          <div class="flex items-center justify-between gap-3">
            <p class="text-[13px] font-medium text-cinza-texto">{hero.clientesTitulo}</p>
            {faixaRola && (
              <button
                type="button"
                id="pausar-logos"
                class="botao-pausa group inline-flex size-10 items-center justify-center rounded-full border border-borda text-preto lg:hidden"
                aria-pressed="false"
                aria-label="Pausar a faixa de logos"
              >
                <Icone nome="pausa" class="size-4 group-aria-pressed:hidden" espessura={2.2} />
                <Icone nome="play" class="hidden size-4 group-aria-pressed:block" />
              </button>
            )}
          </div>
          <div
            class:list={['faixa-logos', faixaRola ? 'faixa-rola -mx-5 overflow-hidden px-5 lg:mx-0 lg:overflow-visible lg:px-0' : '']}
            style={`--colunas: ${colunas}`}
          >
            <div class:list={['trilho-logos flex gap-3', faixaRola ? 'w-max lg:w-full' : 'w-full']}>
              {(faixaRola ? [0, 1] : [0]).map((copia) => (
                <ul
                  class:list={[
                    'gap-3 lg:grid lg:w-full lg:grid-cols-[repeat(var(--colunas),minmax(0,1fr))] lg:gap-5',
                    faixaRola ? 'flex' : 'grid w-full grid-cols-[repeat(var(--colunas),minmax(0,1fr))]',
                    copia === 1 && 'copia-logos lg:hidden',
                  ]}
                  aria-hidden={copia === 1 ? 'true' : undefined}
                >
                  {logos.map((logo) => (
                    <li class:list={['logo-cliente flex h-16 shrink-0 items-center justify-center px-3 lg:w-auto', faixaRola && 'w-[150px]']}>
                      <img
                        src={logo.src}
                        alt={copia === 1 ? '' : logo.alt}
                        width={logo.largura}
                        height={logo.altura}
                        loading="lazy"
                        decoding="async"
                        class="h-auto max-h-10 w-auto max-w-full object-contain"
                      />
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .circulo {
    position: absolute;
    top: 50%;
    left: 50%;
    border-width: 1px;
    border-radius: 9999px;
    translate: -50% -50%;
    animation: respira 9s ease-in-out infinite;
  }
  @keyframes respira {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.035;
    }
  }
  .flutua {
    animation: flutua 6s ease-in-out infinite;
  }
  @keyframes flutua {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }
  /* Selo: só o texto em volta gira, bem devagar; o dente fica parado */
  @media (prefers-reduced-motion: no-preference) {
    .selo-texto {
      animation: gira 30s linear infinite;
    }
    @keyframes gira {
      to {
        rotate: 360deg;
      }
    }
  }

  /* Logos: escala de cinza e 60% de opacidade; cor e opacidade total no hover */
  .logo-cliente {
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }
  @media (hover: hover) {
    .logo-cliente:hover {
      filter: none;
      opacity: 1;
    }
  }
  /* Faixa automática só no celular/tablet e só sem redução de movimento */
  @media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    .faixa-rola .trilho-logos {
      animation: faixa 28s linear infinite;
    }
    .faixa-rola:hover .trilho-logos,
    .faixa-rola:focus-within .trilho-logos,
    :global(.faixa-pausada) .trilho-logos {
      animation-play-state: paused;
    }
    @keyframes faixa {
      to {
        /* anda exatamente uma cópia da lista (metade do trilho + meio espaçamento) */
        translate: calc(-50% - 6px) 0;
      }
    }
  }
  @media (max-width: 1023px) and (prefers-reduced-motion: reduce) {
    .trilho-logos {
      width: 100%;
    }
    .trilho-logos > ul:first-child {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
    .trilho-logos .logo-cliente {
      width: auto;
    }
    .copia-logos,
    .botao-pausa {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .entrada {
      animation: sobe 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .entrada-2 {
      animation-delay: 0.15s;
    }
    @keyframes sobe {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .circulo,
    .flutua {
      animation: none;
    }
  }
</style>

<script>
  // Botão de pausa da faixa de logos (celular)
  const botaoPausa = document.getElementById('pausar-logos');
  const faixa = document.querySelector('.faixa-logos');
  if (botaoPausa && faixa) {
    botaoPausa.addEventListener('click', () => {
      const pausado = botaoPausa.getAttribute('aria-pressed') !== 'true';
      botaoPausa.setAttribute('aria-pressed', String(pausado));
      faixa.classList.toggle('faixa-pausada', pausado);
    });
  }
</script>
