---
// 1. Hero — promessa
import fs from 'node:fs';
import path from 'node:path';
import { hero } from '../content/conteudo';
import Botao from './ui/Botao.astro';
import Icone from './ui/Icone.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Arquivos = Record<string, { default: ImageMetadata }>;
const nomeDoArquivo = (caminho: string) => caminho.split('/').pop()!.replace(/\.[^.]+$/, '');

// Fotos dos sócios (src/assets/socios/), achadas pelo campo "foto" do conteúdo
const fotos: Arquivos = import.meta.glob('../assets/socios/*.{png,jpg,jpeg,webp}', { eager: true });
const fotoDe = (nome: string) => Object.entries(fotos).find(([caminho]) => nomeDoArquivo(caminho) === nome)?.[1].default;

// Enquadramento de cada foto (em % do cartão, que é 3:4): calculado para os olhos ficarem
// a 38% da altura e os dois rostos no mesmo tamanho (mesma distância entre as pupilas).
// Se trocar uma foto, refaça estes números.
const enquadramento: Record<string, { largura: number; esquerda: number; topo: number }> = {
  vinicius: { largura: 104.9, esquerda: -2.66, topo: -15.4 },
  felipe: { largura: 113.2, esquerda: -8.5, topo: -14.85 },
};

// Título: o "\n" do conteúdo vira quebra de linha só no computador
const linhasTitulo = hero.titulo.antes.split('\n');
// "R$" e números nunca ficam sozinhos no fim da linha ("R$ 115", "3 meses")
const semQuebraNoValor = (texto: string) => texto.replace(/(R\$|\d) /g, '$1 ');

// Logos de clientes: lidos de public/img/clientes/ na hora do build (só SVG e PNG).
// O nome do arquivo vira o nome da clínica: "clinica-sorriso.png" → "Clinica Sorriso";
// nomes já com maiúsculas/acentos ficam como estão.
const pastaLogos = path.join(process.cwd(), 'public', 'img', 'clientes');
const arquivosLogos = fs.existsSync(pastaLogos) ? fs.readdirSync(pastaLogos).filter((a) => /\.(svg|png)$/i.test(a)) : [];
// Largura e altura reais, para o navegador reservar o espaço antes de carregar
const medidas = (arquivo: string) => {
  const conteudo = fs.readFileSync(path.join(pastaLogos, arquivo));
  if (/\.png$/i.test(arquivo)) return { largura: conteudo.readUInt32BE(16), altura: conteudo.readUInt32BE(20) };
  const caixa = conteudo.toString('utf8').match(/viewBox=["'][\d.\-]+[\s,]+[\d.\-]+[\s,]+([\d.]+)[\s,]+([\d.]+)/);
  return caixa ? { largura: Math.round(+caixa[1]), altura: Math.round(+caixa[2]) } : {};
};
const logos = arquivosLogos
  .map((arquivo) => {
    const nome = nomeDoArquivo(arquivo).replace(/[-_]+/g, ' ').trim();
    const alt = nome === nome.toLowerCase() ? nome.replace(/(^|\s)\S/g, (l) => l.toUpperCase()) : nome;
    return { src: `/img/clientes/${encodeURIComponent(arquivo)}`, alt, ...medidas(arquivo) };
  })
  .sort((a, b) => a.alt.localeCompare(b.alt, 'pt-BR'));
// Posições da faixa: os logos reais ocupam as primeiras; as que sobram mostram o marcador provisório
const posicoes = Array.from({ length: Math.max(hero.clientes.length, logos.length) }, (_, i) => logos[i] ?? hero.clientes[i]);
---

<!-- Topo: 72px abaixo do cabeçalho fixo (72px de cabeçalho no celular, 88px a partir de 768px) -->
<section id="inicio" class="relative overflow-hidden pt-[104px] pb-[72px] md:pt-[136px] lg:pt-[160px]" aria-labelledby="titulo-hero">
  <div class="container-lp">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,600px)_440px] lg:justify-between lg:gap-x-12 xl:gap-x-20">
      <!-- Texto: tudo na mesma borda esquerda -->
      <div class="entrada @container flex flex-col items-start">
        <p class="rounded-pilula border border-borda px-3.5 py-1.5 text-xs font-medium md:text-[13px]">{hero.etiqueta}</p>
        <h1 id="titulo-hero" class="titulo-hero mt-6 text-[34px] leading-[1.12] tracking-[-0.025em] text-balance">
          {
            linhasTitulo.map((linha, i) => (
              <>
                {linha}
                {i < linhasTitulo.length - 1 && <br class="hidden lg:block" />}
              </>
            ))
          }<br class="hidden lg:block" /><span class="text-ciano-escuro">{hero.titulo.destaque}</span>
        </h1>
        <p class="mt-6 max-w-[500px] text-[17px] leading-[1.6] text-cinza-texto lg:text-lg">{hero.subtitulo}</p>
        <div class="mt-8 flex w-full flex-col gap-4 lg:w-auto lg:flex-row">
          <Botao href={hero.botaoPrincipal.href} shimmerAuto class="shadow-[0_6px_18px_rgba(41,217,213,0.28)]!">{hero.botaoPrincipal.texto}</Botao>
          <Botao href={hero.botaoSecundario.href} variante="contorno">{hero.botaoSecundario.texto}</Botao>
        </div>
        <p class="mt-4 flex items-center gap-2 text-sm text-cinza-texto">
          <Icone nome="check" class="size-4 shrink-0 text-ciano-escuro" espessura={2} />
          {hero.notaBotao}
        </p>
      </div>

      <!-- Fotos: lado a lado no celular/tablet; escalonadas num bloco de 440×420 a partir de 1024px -->
      <div class="entrada entrada-2 relative isolate mx-auto w-full max-w-[560px] pt-9 lg:mx-0 lg:h-[420px] lg:w-[440px] lg:max-w-none lg:pt-0">
        <!-- Dois círculos centralizados atrás do bloco, sem chegar na coluna de texto -->
        <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
          <div class="circulo aspect-square w-[min(520px,100%)] border-ciano/25 lg:w-[520px]"></div>
          <div
            class="circulo aspect-square w-[min(400px,72%)] border-ciano/40 lg:w-[400px] bg-[radial-gradient(circle,rgba(41,217,213,0.2),rgba(41,217,213,0)_70%)] [animation-delay:-4s]"
          >
          </div>
        </div>

        <!-- O cartão B fica por cima do A, com contorno branco de 6px do lado da sobreposição -->
        <div class="flex justify-between lg:block">
          {
            hero.socios.map((socio, i) => {
              const foto = fotoDe(socio.foto);
              const quadro = enquadramento[socio.foto] ?? { largura: 100, esquerda: 0, topo: 0 };
              const cartao = (
                <div class="relative aspect-[3/4] w-full overflow-hidden rounded-[20px] bg-cinza-claro lg:aspect-auto lg:h-[310px] lg:w-[232px]">
                  {foto && (
                    <Image
                      src={foto}
                      alt={socio.alt}
                      widths={[400, 800]}
                      format="webp"
                      sizes="(min-width:1024px) 264px, 54vw"
                      loading="eager"
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                      class="absolute h-auto max-w-none"
                      style={`width:${quadro.largura}%;left:${quadro.esquerda}%;top:${quadro.topo}%`}
                    />
                  )}
                  <!-- Nome e cargo na base da foto, sobre degradê escuro -->
                  <div class="absolute inset-x-0 bottom-0 flex h-24 flex-col justify-end bg-linear-to-t from-[rgba(20,20,20,0.75)] to-transparent p-3 text-branco sm:p-4">
                    <p class="text-[15px] leading-tight font-semibold">{socio.nome}</p>
                    <p class="mt-0.5 truncate text-[13px] text-branco/90">{socio.funcao}</p>
                  </div>
                </div>
              );
              return i === 0 ? (
                <div class="w-[48%] lg:absolute lg:top-0 lg:left-0 lg:w-auto">{cartao}</div>
              ) : (
                <div class="w-[48%] lg:absolute lg:right-0 lg:bottom-0 lg:z-10 lg:w-auto lg:rounded-[26px] lg:bg-branco lg:pt-1.5 lg:pl-1.5">{cartao}</div>
              );
            })
          }
        </div>

        <!-- Selo (decorativo): na divisa das fotos no celular; no canto vazio acima do cartão B no computador -->
        <div
          class="absolute top-9 left-1/2 z-20 size-[72px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-ciano bg-branco lg:top-0 lg:right-6 lg:left-auto lg:size-[92px] lg:translate-x-0 lg:translate-y-0"
          aria-hidden="true"
        >
          <svg viewBox="0 0 92 92" class="absolute inset-0 size-full">
            <defs>
              <!-- Arco de cima passa por cima do círculo; o de baixo vai da esquerda para a direita por baixo -->
              <path id="selo-arco-cima" d="M14.82,64 A36,36 0 1,1 77.18,64"></path>
              <path id="selo-arco-baixo" d="M9.19,67.25 A42.5,42.5 0 0,0 82.81,67.25"></path>
            </defs>
            <text class="fill-preto font-semibold" font-size="9" letter-spacing="1.5" text-anchor="middle">
              <textPath href="#selo-arco-cima" startOffset="50%">{hero.selo.arcoCima}</textPath>
            </text>
            <text class="fill-preto font-semibold" font-size="9" letter-spacing="1.5" text-anchor="middle">
              <textPath href="#selo-arco-baixo" startOffset="50%">{hero.selo.arcoBaixo}</textPath>
            </text>
          </svg>
          <img src="/icon-192.png" alt="" width="192" height="192" class="absolute top-1/2 left-1/2 size-[36%] -translate-x-1/2 -translate-y-1/2" />
        </div>

        <!-- Cartão do case: abaixo das fotos no celular; no canto vazio abaixo do cartão A no computador -->
        <div
          class="cartao-case mt-4 rounded-[14px] bg-preto px-4 py-3 text-branco shadow-[0_12px_30px_rgba(20,20,20,0.2)] lg:absolute lg:bottom-0 lg:left-0 lg:mt-0 lg:w-[184px] lg:px-3.5 lg:py-2.5"
        >
          <p class="text-[13px] leading-snug font-bold tabular-nums" data-contar>{semQuebraNoValor(hero.cardCase.titulo)}</p>
          <p class="text-[13px] leading-snug text-balance text-cinza-escuro-texto">{semQuebraNoValor(hero.cardCase.texto)}</p>
        </div>
      </div>
    </div>

    <!-- Logos de clientes: 6 posições, sempre visíveis. Cada posição mostra o logo real de
         public/img/clientes/ (em cinza) ou, sem arquivo, o marcador provisório.
         No celular, faixa que rola sozinha (pausável). -->
    <div class="mt-14 flex flex-col gap-4" data-revelar>
      <div class="flex items-center justify-between gap-3">
        <p class="text-[13px] font-medium text-cinza-texto">{hero.clientesTitulo}</p>
        <button
          type="button"
          id="pausar-logos"
          class="botao-pausa group inline-flex size-10 items-center justify-center rounded-full border border-borda text-preto lg:hidden"
          aria-pressed="false"
          aria-label="Pausar a faixa de logos"
        >
          <Icone nome="pausa" class="size-4 group-aria-pressed:hidden" espessura={2.2} />
          <Icone nome="play" class="hidden size-4 group-aria-pressed:block" />
        </button>
      </div>
      <div class="faixa-logos faixa-rola -mx-5 overflow-hidden px-5 lg:mx-0 lg:overflow-visible lg:px-0" style={`--colunas: ${posicoes.length}`}>
        <div class="trilho-logos flex w-max gap-3 lg:w-full">
          {
            [0, 1].map((copia) => (
              <ul
                class:list={[
                  'flex gap-3 lg:grid lg:w-full lg:grid-cols-[repeat(var(--colunas),minmax(0,1fr))] lg:gap-5',
                  copia === 1 && 'copia-logos lg:hidden',
                ]}
                aria-hidden={copia === 1 ? 'true' : undefined}
              >
                {posicoes.map((posicao) =>
                  typeof posicao === 'string' ? (
                    <li class="logo-cliente flex h-16 w-[150px] shrink-0 items-center justify-center rounded-xl border-[1.5px] border-dashed border-[#C9D3D3] px-2 text-center text-xs text-cinza-texto lg:w-auto">
                      {posicao}
                    </li>
                  ) : (
                    <li class="logo-cliente flex h-16 w-[150px] shrink-0 items-center justify-center px-3 lg:w-auto">
                      <img
                        src={posicao.src}
                        alt={copia === 1 ? '' : posicao.alt}
                        width={posicao.largura}
                        height={posicao.altura}
                        loading="lazy"
                        decoding="async"
                        class="h-auto max-h-10 w-auto max-w-full object-contain"
                      />
                    </li>
                  ),
                )}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .circulo {
    position: absolute;
    top: 50%;
    left: 50%;
    border-width: 1px;
    border-radius: 9999px;
    translate: -50% -50%;
    animation: respira 9s ease-in-out infinite;
  }
  @keyframes respira {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.035;
    }
  }
  /* Título: 34px com quebra automática no celular/tablet. A partir de 1024px, exatamente 3 linhas
     (quebras pelo <br>): encolhe junto com a coluna até 1279px e fica em 46px no computador */
  @media (min-width: 1024px) {
    .titulo-hero {
      font-size: min(46px, calc(100cqi / 13.8));
      white-space: nowrap;
    }
  }
  @media (min-width: 1280px) {
    .titulo-hero {
      font-size: 46px;
    }
  }

  /* Cartão do case flutua de leve só no computador (no celular fica parado, abaixo das fotos) */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .cartao-case {
      animation: flutua 6s ease-in-out infinite;
    }
    @keyframes flutua {
      0%,
      100% {
        translate: 0 0;
      }
      50% {
        translate: 0 -6px;
      }
    }
  }

  /* Logos: escala de cinza e 60% de opacidade; cor e opacidade total no hover */
  .logo-cliente {
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }
  @media (hover: hover) {
    .logo-cliente:hover {
      filter: none;
      opacity: 1;
    }
  }
  /* Faixa automática só no celular/tablet e só sem redução de movimento */
  @media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    .faixa-rola .trilho-logos {
      animation: faixa 28s linear infinite;
    }
    .faixa-rola:hover .trilho-logos,
    .faixa-rola:focus-within .trilho-logos,
    :global(.faixa-pausada) .trilho-logos {
      animation-play-state: paused;
    }
    @keyframes faixa {
      to {
        /* anda exatamente uma cópia da lista (metade do trilho + meio espaçamento) */
        translate: calc(-50% - 6px) 0;
      }
    }
  }
  @media (max-width: 1023px) and (prefers-reduced-motion: reduce) {
    .trilho-logos {
      width: 100%;
    }
    .trilho-logos > ul:first-child {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
    .trilho-logos .logo-cliente {
      width: auto;
    }
    .copia-logos,
    .botao-pausa {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .entrada {
      animation: sobe 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .entrada-2 {
      animation-delay: 0.15s;
    }
    @keyframes sobe {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .circulo {
      animation: none;
    }
  }
</style>

<script>
  // Botão de pausa da faixa de logos (celular)
  const botaoPausa = document.getElementById('pausar-logos');
  const faixa = document.querySelector('.faixa-logos');
  if (botaoPausa && faixa) {
    botaoPausa.addEventListener('click', () => {
      const pausado = botaoPausa.getAttribute('aria-pressed') !== 'true';
      botaoPausa.setAttribute('aria-pressed', String(pausado));
      faixa.classList.toggle('faixa-pausada', pausado);
    });
  }
</script>
