---
// 1. Hero — promessa
import { hero } from '../content/conteudo';
import Botao from './ui/Botao.astro';
import Icone from './ui/Icone.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Arquivos = Record<string, { default: ImageMetadata }>;
const nomeDoArquivo = (caminho: string) => caminho.split('/').pop()!.replace(/\.[^.]+$/, '');

// Fotos dos sócios (src/assets/socios/), achadas pelo campo "foto" do conteúdo
const fotos: Arquivos = import.meta.glob('../assets/socios/*.{png,jpg,jpeg,webp}', { eager: true });
const fotoDe = (nome: string) => Object.entries(fotos).find(([caminho]) => nomeDoArquivo(caminho) === nome)?.[1].default;

// Enquadramento das fotos: os olhos ficam a 38% da altura do cartão e os dois rostos no mesmo
// tamanho (mesma distância entre as pupilas). Posição das pupilas medida em cada arquivo
// (fração da largura e da altura da foto). Se trocar uma foto, meça e atualize aqui.
const PROPORCAO_FOTO = 1800 / 1200; // altura ÷ largura dos arquivos
const ALTURA_OLHOS = 0.38;
const pupilas: Record<string, { esquerda: number[]; direita: number[] }> = {
  vinicius: { esquerda: [0.4, 0.448], direita: [0.605, 0.457] },
  felipe: { esquerda: [0.423, 0.403], direita: [0.61, 0.427] },
};
// Devolve largura, esquerda e topo da foto (em %) para um cartão de proporção altura ÷ largura
const enquadrar = (proporcaoCartao: number) => {
  const dados = Object.entries(pupilas).map(([nome, { esquerda, direita }]) => {
    const x = (esquerda[0] + direita[0]) / 2;
    const y = (esquerda[1] + direita[1]) / 2;
    const distancia = Math.hypot(direita[0] - esquerda[0], (direita[1] - esquerda[1]) * PROPORCAO_FOTO);
    // menor ampliação que ainda cobre o cartão inteiro com os olhos no lugar
    const minima = Math.max(
      0.5 / x,
      0.5 / (1 - x),
      (ALTURA_OLHOS * proporcaoCartao) / (PROPORCAO_FOTO * y),
      ((1 - ALTURA_OLHOS) * proporcaoCartao) / (PROPORCAO_FOTO * (1 - y)),
    );
    return { nome, x, y, distancia, minima };
  });
  const distanciaFinal = Math.max(...dados.map((f) => f.minima * f.distancia)) * 1.02;
  return Object.fromEntries(
    dados.map((f) => {
      const escala = distanciaFinal / f.distancia;
      return [
        f.nome,
        {
          largura: `${(escala * 100).toFixed(2)}%`,
          esquerda: `${((0.5 - f.x * escala) * 100).toFixed(2)}%`,
          topo: `${(((ALTURA_OLHOS * proporcaoCartao - f.y * PROPORCAO_FOTO * escala) / proporcaoCartao) * 100).toFixed(2)}%`,
        },
      ];
    }),
  );
};
const quadros = {
  celular: enquadrar(4 / 3), // cartões 3:4 abaixo de 1024px
  medio: enquadrar(310 / 232), // 1024–1279px
  grande: enquadrar(384 / 268), // a partir de 1280px
};

// Dente da logo em vetor (contorno traçado do ícone da marca), para o selo circular
const DENTE_LOGO =
  'M 242 49 C 241 49 238 50 235 50 C 211 55 191 67 168 91 C 145 113 130 122 104 127 C 90 129 90 129 98 122 C 109 113 125 97 129 91 C 134 86 137 79 137 79 C 137 78 135 77 132 76 C 130 75 126 73 122 71 C 118 69 112 66 107 64 C 96 59 98 58 81 75 C -4 157 -21 285 40 387 C 53 408 74 434 93 450 L 102 457 105 441 C 115 378 132 345 164 323 C 173 317 198 307 200 308 C 200 309 197 312 194 316 C 178 335 165 355 167 357 C 171 362 179 382 183 394 C 186 406 187 408 188 414 C 191 425 192 431 194 442 C 194 449 196 456 196 459 C 197 462 197 470 198 476 C 200 502 200 503 202 503 C 206 505 229 508 240 509 L 254 509 256 505 C 262 491 267 477 270 456 C 271 452 272 445 273 443 C 273 441 275 433 275 426 C 280 391 283 373 288 356 C 293 338 293 337 297 328 C 298 327 299 323 300 320 C 303 312 313 293 320 281 C 322 276 328 267 332 260 C 336 253 340 246 341 244 C 341 242 343 238 345 234 C 371 179 370 124 343 89 C 332 76 318 64 304 57 C 289 51 280 49 262 48 C 252 48 244 48 242 49';

// Título: o "\n" do conteúdo vira quebra de linha só no computador
const linhasTitulo = hero.titulo.antes.split('\n');
// "R$" e números nunca ficam sozinhos no fim da linha ("R$ 115", "3 meses")
const semQuebraNoValor = (texto: string) => texto.replace(/(R\$|\d) /g, '$1 ');

// Logos de clientes: os arquivos ficam em src/assets/clientes/ (SVG ou PNG, até 10). No build, a
// integração integracoes/recortar-logos.mjs tira a margem branca/transparente de cada um e salva em
// src/assets/clientes-recortados/, que é lida aqui em ordem alfabética do nome do arquivo e otimizada
// pelo componente de imagem do Astro. O texto alternativo
// vem do nome, sem o número inicial e com hífens virando espaços: "01-clinica-sorriso.png" → "Clinica Sorriso";
// nomes com maiúsculas/acentos ficam como estão ("04-Ateliê Miraz.png" → "Ateliê Miraz").
const arquivosLogos: Arquivos = import.meta.glob('../assets/clientes-recortados/*.{svg,png,SVG,PNG}', { eager: true });
const logos = Object.entries(arquivosLogos)
  .sort(([a], [b]) => a.localeCompare(b, 'pt-BR', { numeric: true }))
  .slice(0, 10)
  .map(([caminho, modulo]) => {
    const nome = decodeURIComponent(nomeDoArquivo(caminho))
      .replace(/^\d+[\s._-]*/, '')
      .replace(/[-_]+/g, ' ')
      .trim();
    const alt = nome === nome.toLowerCase() ? nome.replace(/(^|\s)\S/g, (l) => l.toUpperCase()) : nome;
    return { imagem: modulo.default, alt };
  });
// Posições do carrossel: os logos reais primeiro; com menos de 6, os marcadores completam
const posicoes = Array.from({ length: Math.max(hero.clientes.length, logos.length) }, (_, i) => logos[i] ?? hero.clientes[i]);
---

<!-- Topo: 72px abaixo do cabeçalho fixo (72px de cabeçalho no celular, 88px a partir de 768px) -->
<section id="inicio" class="relative isolate overflow-x-clip pt-[104px] pb-[72px] md:pt-[136px] lg:pt-[160px]" aria-labelledby="titulo-hero">
  <!-- Brilho discreto no canto superior esquerdo (decorativo) -->
  <div class="brilho-canto pointer-events-none absolute -top-24 -left-28 -z-10 size-[380px] rounded-full bg-ciano/16 blur-[80px]" aria-hidden="true"></div>

  <div class="container-lp">
    <div
      class="grid items-center gap-12 lg:grid-cols-[minmax(0,600px)_440px] lg:justify-between lg:gap-x-12 xl:grid-cols-[610px_minmax(0,1fr)] xl:gap-x-10"
    >
      <!-- Texto: tudo na mesma borda esquerda (acima dos efeitos de fundo) -->
      <div class="entrada @container relative z-10 flex flex-col items-start">
        <p class="inline-flex items-center gap-2.5 rounded-pilula border border-ciano bg-[#E3FAF8] py-2 pr-4 pl-2 text-sm leading-snug font-semibold text-preto">
          <span class="flex size-[26px] shrink-0 items-center justify-center rounded-full bg-ciano" aria-hidden="true">
            <!-- Dente em traço, no estilo do ícone "tooth" do Phosphor (peso regular) -->
            <svg viewBox="0 0 256 256" class="size-4" fill="none" stroke="#141414" stroke-width="16" stroke-linecap="round" stroke-linejoin="round">
              <path
                d="M86,40C58,40,40,62,40,94c0,38,22,56,30,88c6,24,12,42,30,42c18,0,18-24,22-40c2-8,3-14,6-14s4,6,6,14c4,16,4,40,22,40c18,0,24-18,30-42c8-32,30-50,30-88c0-32-18-54-46-54c-18,0-28,10-42,10S104,40,86,40Z"
              ></path>
              <path d="M128,50c12,8,26,12,42,12"></path>
            </svg>
          </span>
          {semQuebraNoValor(hero.etiqueta)}
        </p>
        <h1 id="titulo-hero" class="titulo-hero mt-6 text-[34px] leading-[1.12] tracking-[-0.025em] text-balance">
          {
            linhasTitulo.map((linha, i) => (
              <>
                {linha}
                {i < linhasTitulo.length - 1 && <br class="hidden lg:block" />}
              </>
            ))
          }<br class="hidden lg:block" /><span class="text-ciano-escuro">{hero.titulo.destaque}</span>
        </h1>
        <p class="mt-6 max-w-[500px] text-[17px] leading-[1.6] text-cinza-texto lg:text-lg">{hero.subtitulo}</p>
        <div class="mt-8 flex w-full flex-col items-center gap-3 lg:w-auto lg:flex-row lg:items-start lg:gap-0">
          <!-- Botão principal com a linha "Gratuito e sem compromisso." centralizada logo abaixo -->
          <div class="flex w-full flex-col items-center lg:w-auto">
            <Botao href={hero.botaoPrincipal.href} shimmerAuto class="w-full shadow-[0_6px_18px_rgba(41,217,213,0.28)]! lg:w-auto">{hero.botaoPrincipal.texto}</Botao>
            <p class="mt-3.5 flex items-center gap-2 text-[15px] font-semibold text-preto">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-[#E3FAF8]" aria-hidden="true">
                <Icone nome="check" class="size-[18px] text-ciano-escuro" espessura={2.2} />
              </span>
              {hero.notaBotao}
            </p>
          </div>
          <!-- Secundário como link de texto (área clicável de 44px; no computador, na altura do centro do botão) -->
          <a
            href={hero.botaoSecundario.href}
            class="inline-flex min-h-11 items-center text-base font-semibold text-preto underline decoration-[1.5px] underline-offset-[6px] transition-colors duration-200 hover:text-ciano-escuro lg:ml-7 lg:h-14"
          >
            {hero.botaoSecundario.texto}
          </a>
        </div>
      </div>

      <!-- Fotos: lado a lado no celular/tablet; escalonadas a partir de 1024px
           (bloco de 440×420 até 1279px; 510×514 a partir de 1280px, avançando 40px além do container) -->
      <div
        class="entrada entrada-2 relative isolate mx-auto w-full max-w-[560px] pt-[78px] lg:mx-0 lg:h-[420px] lg:w-[440px] lg:max-w-none lg:pt-0 xl:-mr-10 xl:h-[514px] xl:w-[510px]"
      >
        <!-- Fundo com movimento (decorativo): brilho que se desloca e quatro anéis em onda,
             centralizados nas fotos. Só transform e opacity. -->
        <div class="pointer-events-none absolute inset-x-0 top-[78px] -z-10 h-0 pb-[64%] lg:inset-0 lg:h-auto lg:pb-0" aria-hidden="true">
          <div class="brilho-fotos absolute top-1/2 left-1/2 size-[380px] rounded-full bg-ciano/30 blur-[60px] lg:size-[520px]"></div>
          {
            [1, 2, 3, 4].map((n) => (
              <div class:list={['onda absolute top-1/2 left-1/2 size-[340px] rounded-full border-[1.5px] border-ciano lg:size-[520px]', n > 1 && `onda-${n}`]} />
            ))
          }
        </div>

        <!-- O cartão B fica por cima do A, com contorno branco de 6px do lado da sobreposição -->
        <div class="flex justify-between lg:block">
          {
            hero.socios.map((socio, i) => {
              const foto = fotoDe(socio.foto);
              // Variáveis de enquadramento por faixa de largura (usadas em .foto-socio)
              const variaveis = (
                [
                  ['', quadros.celular],
                  ['-lg', quadros.medio],
                  ['-xl', quadros.grande],
                ] as const
              )
                .map(([s, q]) => {
                  const f = q[socio.foto];
                  return f ? `--largura${s}:${f.largura};--esquerda${s}:${f.esquerda};--topo${s}:${f.topo}` : '';
                })
                .join(';');
              const cartao = (
                <div class="moldura-foto relative aspect-[3/4] w-full overflow-hidden rounded-[20px] bg-cinza-claro lg:aspect-auto lg:h-[310px] lg:w-[232px] xl:h-[384px] xl:w-[268px]">
                  {foto && (
                    <Image
                      src={foto}
                      alt={socio.alt}
                      widths={[400, 800]}
                      format="webp"
                      sizes="(min-width:1280px) 320px, (min-width:1024px) 275px, 56vw"
                      loading="eager"
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                      class="foto-socio absolute h-auto max-w-none"
                      style={variaveis}
                    />
                  )}
                  <!-- Nome e cargo na base da foto, sobre degradê escuro -->
                  <div class="absolute inset-x-0 bottom-0 flex h-24 flex-col justify-end bg-linear-to-t from-[rgba(20,20,20,0.75)] to-transparent p-3 text-branco sm:p-4">
                    <p class="text-[15px] leading-tight font-semibold xl:text-base">{socio.nome}</p>
                    <p class="mt-0.5 truncate text-[13px] text-branco/90 xl:text-[13.5px]">{socio.funcao}</p>
                  </div>
                </div>
              );
              return i === 0 ? (
                <div class="cartao-socio relative w-[48%] rounded-[20px] lg:absolute lg:top-0 lg:left-0 lg:w-auto">{cartao}</div>
              ) : (
                <div class="cartao-socio relative w-[48%] rounded-[20px] lg:absolute lg:right-0 lg:bottom-0 lg:z-10 lg:w-auto lg:rounded-[26px] lg:bg-branco lg:pt-1.5 lg:pl-1.5">
                  {cartao}
                </div>
              );
            })
          }
        </div>

        <!-- Selo (decorativo): na junção dos dois cartões, sobrepondo cerca de 10px cada um, acima deles.
             No celular, centralizado na divisa, entrando 10px no topo das fotos. Só o anel de texto gira. -->
        <div
          class="selo absolute top-0 left-1/2 z-20 size-[88px] -translate-x-1/2 rounded-full border-[1.5px] border-ciano-escuro bg-branco/88 shadow-[0_6px_20px_rgba(20,20,20,0.10)] backdrop-blur-[8px] lg:left-[222px] lg:size-[120px] lg:translate-x-0 xl:top-5 xl:left-[258px]"
          aria-hidden="true"
        >
          <svg viewBox="0 0 120 120" class="absolute inset-0 size-full overflow-visible">
            <defs>
              <!-- Círculo completo a partir do topo, no sentido horário. Raio 48,92: a volta (307,4) tem o
                   comprimento do texto com letter-spacing 3px, então fecha sem sobra nem sobreposição -->
              <path id="selo-anel" d="M60,11.08 a48.92,48.92 0 1,1 0,97.84 a48.92,48.92 0 1,1 0,-97.84"></path>
            </defs>
            <!-- Anel de texto: textLength = circunferência (garante o fechamento mesmo se a fonte variar) -->
            <g class="selo-anel-texto">
              <text class="fill-preto font-semibold" font-size="10.5" letter-spacing="3">
                <textPath href="#selo-anel" textLength="307.37" lengthAdjust="spacing">{hero.selo.anel}</textPath>
              </text>
            </g>
            <circle cx="60" cy="60" r="38" fill="none" stroke="#0B7A77" stroke-width="1" stroke-dasharray="1 5"></circle>
            <!-- Dente da logo (vetorizado do ícone), 30px de altura, parado no centro -->
            <svg x="48.25" y="45" width="23.5" height="30" viewBox="3 48 361 461">
              <path fill="#29D9D5" d={DENTE_LOGO}></path>
            </svg>
          </svg>
        </div>

        <!-- Cartão do case: abaixo das fotos no celular; no canto abaixo do cartão A no computador
             (entre 1024 e 1279px, letra e padding um pouco menores para não encostar no cartão B) -->
        <div
          class="cartao-case relative z-20 mt-4 rounded-[14px] bg-preto px-[18px] py-3.5 text-branco shadow-[0_12px_30px_rgba(20,20,20,0.2)] lg:absolute lg:bottom-0 lg:left-0 lg:mt-0 lg:max-w-[226px] lg:px-3 lg:py-3 xl:top-[400px] xl:bottom-auto xl:px-[18px] xl:py-3.5"
        >
          <p class="text-sm leading-snug font-semibold whitespace-nowrap tabular-nums lg:text-[13px] xl:text-sm" data-contar>{semQuebraNoValor(hero.cardCase.titulo)}</p>
          <p class="mt-0.5 text-[12.5px] leading-snug whitespace-nowrap text-branco/75 lg:text-[11.5px] xl:text-[12.5px]">{semQuebraNoValor(hero.cardCase.texto)}</p>
        </div>
      </div>
    </div>

    <!-- Logos de clientes em carrossel contínuo (decorativo). Pausa com o mouse por cima, enquanto o
         usuário segura o clique/toque e com foco pelo teclado. Cada posição mostra o logo real de
         src/assets/clientes/ (em cinza) ou, sem arquivo, o marcador provisório. -->
    <div class="mt-16" data-revelar>
      <p class="mb-5 text-[15px] font-semibold text-preto">{hero.clientesTitulo}</p>
      <!-- tabindex: pelo teclado, o foco na faixa também pausa (e permite rolar com animações reduzidas) -->
      <div class="faixa-logos" style={`--quantidade: ${posicoes.length}`} tabindex="0" role="region" aria-label={hero.clientesTitulo}>
        <div class="trilho-logos flex w-max">
          {
            [0, 1].map((copia) => (
              <ul class:list={['lista-logos flex', copia === 1 && 'copia-logos']} aria-hidden={copia === 1 ? 'true' : undefined}>
                {posicoes.map((posicao) =>
                  typeof posicao === 'string' ? (
                    <li class="logo-cliente caixa-logo flex shrink-0 items-center justify-center rounded-2xl border-[1.5px] border-dashed border-[#C9D3D3] bg-branco px-2 text-center text-xs text-cinza-texto">
                      {posicao}
                    </li>
                  ) : (
                    <li class="caixa-logo flex shrink-0 items-center justify-center rounded-2xl border border-borda bg-branco px-4">
                      <!-- PNG vira WebP em 2 tamanhos (tela comum e retina); SVG é usado como está.
                           Carregamento imediato: dentro da faixa com overflow escondido, o "lazy" só baixaria
                           o logo quando ele já estivesse entrando (aparecendo em branco por um instante) -->
                      <Image
                        src={posicao.imagem}
                        alt={copia === 1 ? '' : posicao.alt}
                        {...(posicao.imagem.format === 'svg' ? {} : { widths: [176, 352], sizes: '176px' })}
                        loading="eager"
                        decoding="async"
                        draggable="false"
                        class="logo-real h-auto max-h-14 w-auto max-w-[min(176px,100%)] object-contain"
                      />
                    </li>
                  ),
                )}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Enquadramento de cada foto (valores calculados no topo do arquivo, por faixa de largura) */
  .foto-socio {
    width: var(--largura);
    left: var(--esquerda);
    top: var(--topo);
  }
  @media (min-width: 1024px) {
    .foto-socio {
      width: var(--largura-lg);
      left: var(--esquerda-lg);
      top: var(--topo-lg);
    }
  }
  @media (min-width: 1280px) {
    .foto-socio {
      width: var(--largura-xl);
      left: var(--esquerda-xl);
      top: var(--topo-xl);
    }
  }

  /* Título: 34px com quebra automática no celular/tablet. A partir de 1024px, exatamente 3 linhas
     (quebras pelo <br>): encolhe junto com a coluna até 1279px e fica em 46px no computador */
  @media (min-width: 1024px) {
    .titulo-hero {
      font-size: min(46px, calc(100cqi / 13.8));
      white-space: nowrap;
    }
  }
  @media (min-width: 1280px) {
    .titulo-hero {
      font-size: 46px;
    }
  }

  /* Fundo com movimento. Os anéis somem (opacidade 0) antes de chegar à coluna de texto. */
  .brilho-fotos,
  .onda {
    transform: translate(-50%, -50%);
  }
  .onda {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .brilho-fotos {
      animation: brilho-fotos 14s ease-in-out infinite alternate;
    }
    .brilho-canto {
      animation: brilho-canto 20s ease-in-out infinite alternate;
    }
    .onda {
      animation: onda 9s linear infinite;
    }
    .onda-2 {
      animation-delay: 2.25s;
    }
    .onda-3 {
      animation-delay: 4.5s;
    }
    .onda-4 {
      animation-delay: 6.75s;
    }
  }
  @keyframes brilho-fotos {
    to {
      transform: translate(calc(-50% + 24px), calc(-50% - 16px)) scale(1.08);
    }
  }
  @keyframes brilho-canto {
    to {
      transform: translate(48px, 32px) scale(1.06);
    }
  }
  @keyframes onda {
    0% {
      transform: translate(-50%, -50%) scale(0.55);
      opacity: 0.8;
    }
    65% {
      opacity: 0;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.25);
      opacity: 0;
    }
  }
  /* Selo: só o anel de texto gira (uma volta a cada 24s); o dente e os tracinhos ficam parados */
  .selo-anel-texto {
    transform-box: view-box;
    transform-origin: 60px 60px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .selo-anel-texto {
      animation: selo-gira 24s linear infinite;
    }
  }
  @keyframes selo-gira {
    to {
      transform: rotate(360deg);
    }
  }

  /* Animações reduzidas: brilhos parados e um único anel estático */
  @media (prefers-reduced-motion: reduce) {
    .onda {
      opacity: 0.3;
    }
    .onda-2,
    .onda-3,
    .onda-4 {
      display: none;
    }
  }

  /* Cartão do case flutua de leve só no computador (no celular fica parado, abaixo das fotos) */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .cartao-case {
      animation: flutua 6s ease-in-out infinite;
    }
    @keyframes flutua {
      0%,
      100% {
        translate: 0 0;
      }
      50% {
        translate: 0 -6px;
      }
    }
  }

  /* Carrossel de logos: 1 caixa e meia visível no celular, 4 no computador; bordas esmaecidas */
  .faixa-logos {
    --vao: 20px;
    --visiveis: 1.5;
    --vaos-visiveis: 1;
    container-type: inline-size;
    overflow: hidden;
    border-radius: 16px;
    mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent);
    /* segurar o clique/toque pausa: sem selecionar texto nem abrir o menu de imagem */
    user-select: none;
    -webkit-touch-callout: none;
  }
  @media (min-width: 1024px) {
    .faixa-logos {
      --visiveis: 4;
      --vaos-visiveis: 3;
    }
  }
  .lista-logos {
    gap: var(--vao);
    /* o espaço depois do último logo faz as duas cópias terem a mesma largura: o loop não salta */
    padding-right: var(--vao);
  }
  .caixa-logo {
    width: calc((100cqi - var(--vaos-visiveis) * var(--vao)) / var(--visiveis));
    height: 104px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .trilho-logos {
      /* cerca de 5s por logo, velocidade constante */
      animation: faixa calc(var(--quantidade) * 5s) linear infinite;
    }
    .faixa-logos:hover .trilho-logos,
    .faixa-logos:focus-visible .trilho-logos,
    :global(.faixa-pausada) .trilho-logos {
      animation-play-state: paused;
    }
    @keyframes faixa {
      to {
        transform: translateX(-50%);
      }
    }
  }
  /* Animações reduzidas: nada se move; a faixa rola na horizontal manualmente */
  @media (prefers-reduced-motion: reduce) {
    .faixa-logos {
      overflow-x: auto;
      mask-image: none;
    }
    .copia-logos {
      display: none;
    }
  }

  /* Marcadores provisórios em cinza e 60% de opacidade; cor e opacidade total no hover */
  .logo-cliente {
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }
  /* Logos reais: escala de cinza com um pouco mais de contraste, sem opacidade reduzida.
     O multiply funde o fundo branco dos PNG com o fundo branco da caixa. */
  .logo-real {
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
    transition: filter 0.3s ease;
  }
  @media (hover: hover) {
    .logo-cliente:hover {
      filter: none;
      opacity: 1;
    }
    .caixa-logo:hover .logo-real {
      filter: none;
    }
  }

  /* Hover no lado direito do hero (só com mouse): cartões das fotos, selo e cartão do case crescem
     um pouco. O cartão em hover sobe acima do outro, mas fica abaixo do selo e do cartão do case (z 20). */
  .cartao-socio,
  .foto-socio,
  .selo,
  .cartao-case {
    transform-origin: center;
    transition:
      scale 350ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .cartao-socio:hover {
      z-index: 15;
      scale: 1.03;
      box-shadow: 0 18px 40px rgba(20, 20, 20, 0.14);
    }
    .cartao-socio:hover .foto-socio {
      scale: 1.05;
    }
    .selo:hover {
      scale: 1.08;
    }
    .cartao-case:hover {
      scale: 1.05;
      box-shadow: 0 18px 40px rgba(20, 20, 20, 0.3);
    }
  }
  /* Animações reduzidas: sem escala, só a sombra */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .cartao-socio:hover,
    .cartao-socio:hover .foto-socio,
    .selo:hover,
    .cartao-case:hover {
      scale: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .entrada {
      animation: sobe 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .entrada-2 {
      animation-delay: 0.15s;
    }
    @keyframes sobe {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
  }
</style>

<script>
  // Faixa de logos: pausa enquanto o usuário segura o clique ou o toque em qualquer ponto
  const faixa = document.querySelector('.faixa-logos');
  if (faixa) {
    faixa.addEventListener('pointerdown', () => faixa.classList.add('faixa-pausada'));
    for (const evento of ['pointerup', 'pointercancel', 'pointerleave']) {
      faixa.addEventListener(evento, () => faixa.classList.remove('faixa-pausada'));
    }
  }
</script>
