---
// 10. Diagnóstico + formulário em 2 etapas (OFERTA)
// ATENÇÃO: o formulário é só visual. Nada é enviado até os sócios definirem o destino.
import { diagnostico } from '../content/conteudo';
import Icone from './ui/Icone.astro';

const { formulario: f } = diagnostico;
const campo =
  'h-12 w-full rounded-[10px] border border-[#C9D3D3] bg-branco px-3.5 text-base text-preto transition-colors placeholder:text-[#6B7575] hover:border-cinza-texto focus:border-ciano-escuro focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ciano-escuro user-invalid:border-[#C2410C]';
const rotulo = 'flex flex-col gap-1.5 text-sm font-semibold';
---

<section id="diagnostico" class="secao bg-branco" aria-labelledby="titulo-diagnostico">
  <!-- Bloco ciano com gradiente sutil, cantos de 28px e brilho suave -->
  <div class="container-lp">
  <div
    class="bloco-cta grid items-start gap-10 rounded-[28px] bg-linear-to-br from-ciano to-[#5FE3E0] px-5 py-10 shadow-[0_30px_80px_-30px_rgba(41,217,213,0.7)] sm:px-8 md:p-12 lg:grid-cols-[1fr_480px] lg:gap-14 lg:p-16"
  >
    <div class="flex flex-col gap-5 lg:pt-3" data-revelar>
      <p class="text-[13px] font-bold tracking-[0.08em] uppercase md:text-sm">{diagnostico.sobretitulo}</p>
      <h2 id="titulo-diagnostico" class="text-[32px] leading-[1.12] tracking-[-0.02em] md:text-[46px]">{diagnostico.titulo}</h2>
      <p class="text-base leading-[1.55] md:text-lg">{diagnostico.texto}</p>
      <div class="flex flex-col gap-2.5 rounded-card bg-branco/50 p-6 md:p-7">
        <h3 class="mb-1 font-texto text-base font-bold">{diagnostico.analisamosTitulo}</h3>
        <ul class="flex flex-col gap-2.5 text-[15px] md:text-base">
          {
            diagnostico.analisamos.map((item) => (
              <li class="flex gap-2.5">
                <Icone nome="check" class="mt-0.5 size-[18px] shrink-0" espessura={2.4} />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-5 rounded-3xl bg-branco p-6 shadow-[0_30px_60px_rgba(20,20,20,0.18)] md:p-10" data-revelar>
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-xl md:text-[22px]">{f.titulo}</h3>
        <p id="rotulo-etapa" class="shrink-0 text-[13px] font-bold text-ciano-escuro" aria-live="polite">{f.etapa(1)}</p>
      </div>
      <div class="grid grid-cols-2 gap-1.5" aria-hidden="true">
        <span class="h-[5px] rounded-sm bg-ciano"></span>
        <span id="barra-etapa-2" class="h-[5px] rounded-sm bg-borda transition-colors duration-500"></span>
      </div>

      <form id="form-diagnostico" novalidate data-etapa2={f.etapa(2)} data-concluido={f.concluido}>
        <!-- Etapa 1 -->
        <fieldset id="etapa-1" class="flex flex-col gap-3.5">
          <legend class="sr-only">{f.etapa(1)}</legend>
          {
            f.etapa1.slice(0, 3).map((c) => (
              <label class={rotulo}>
                {c.rotulo}
                <input
                  type={c.tipo}
                  name={c.nome}
                  placeholder={c.placeholder}
                  autocomplete={c.autocomplete}
                  required
                  inputmode={c.tipo === 'tel' ? 'tel' : undefined}
                  class={campo}
                />
              </label>
            ))
          }
          <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-3">
            {
              f.etapa1.slice(3).map((c) => (
                <label class={rotulo}>
                  {c.rotulo}
                  <input
                    type={c.tipo}
                    name={c.nome}
                    placeholder={c.placeholder}
                    autocomplete={c.autocomplete}
                    required={c.nome !== 'instagram'}
                    spellcheck={c.nome === 'instagram' ? 'false' : undefined}
                    class={campo}
                  />
                </label>
              ))
            }
          </div>
          <button
            type="button"
            id="botao-continuar"
            class="group mt-1.5 inline-flex min-h-14 items-center justify-center gap-2 rounded-pilula bg-preto text-base font-bold text-branco transition-colors hover:bg-[#2a2d2d]"
          >
            {f.continuar}
            <Icone nome="seta" class="size-[18px] transition-transform group-hover:translate-x-1" espessura={2} />
          </button>
        </fieldset>

        <!-- Etapa 2 -->
        <fieldset id="etapa-2" class="flex flex-col gap-3.5" hidden disabled>
          <legend class="sr-only">{f.etapa(2)}</legend>
          <label class={rotulo}>
            {f.etapa2[0].rotulo}
            <select name={f.etapa2[0].nome} required class={`${campo} px-3`}>
              <option value="">{f.selecione}</option>
              {f.etapa2[0].opcoes.map((o) => <option>{o}</option>)}
            </select>
          </label>
          <div class="grid gap-3.5 sm:grid-cols-2 sm:gap-3">
            {
              f.etapa2.slice(1).map((c) => (
                <label class={rotulo}>
                  {c.rotulo}
                  <select name={c.nome} required class={`${campo} px-3`}>
                    <option value="">{f.selecione}</option>
                    {c.opcoes.map((o) => (
                      <option>{o}</option>
                    ))}
                  </select>
                </label>
              ))
            }
          </div>
          <label class="mt-1 flex items-start gap-2.5 text-[13px] leading-[1.45] text-cinza-texto">
            <input type="checkbox" name="lgpd" required class="mt-0.5 size-[18px] shrink-0 accent-ciano-escuro" />
            {f.lgpd}
          </label>
          <button
            type="submit"
            class="mt-1.5 inline-flex min-h-14 items-center justify-center rounded-pilula bg-preto px-4 text-base font-bold text-branco transition-colors hover:bg-[#2a2d2d]"
          >
            {f.enviar}
          </button>
          <button
            type="button"
            id="botao-voltar"
            class="inline-flex min-h-11 items-center justify-center gap-1.5 text-sm font-bold text-ciano-escuro hover:underline"
          >
            <Icone nome="seta-esquerda" class="size-4" espessura={2.2} />
            {f.voltar}
          </button>
        </fieldset>
      </form>

      <!-- Confirmação -->
      <div id="confirmacao" class="flex flex-col items-center gap-3.5 py-10 text-center" hidden tabindex="-1">
        <span class="flex size-16 items-center justify-center rounded-full bg-ciano">
          <Icone nome="check" class="size-7" espessura={2.6} />
        </span>
        <p class="font-titulo text-[22px] font-medium">{f.confirmacaoTitulo}</p>
        <p class="text-[15px] leading-normal text-cinza-texto">{f.confirmacaoTexto}</p>
        <button type="button" id="botao-reiniciar" class="min-h-11 text-sm font-bold text-ciano-escuro hover:underline">
          {f.verDeNovo}
        </button>
      </div>
    </div>
  </div>
  </div>
</section>

<script>
  const form = document.getElementById('form-diagnostico') as HTMLFormElement | null;
  if (form) {
    const etapa1 = document.getElementById('etapa-1') as HTMLFieldSetElement;
    const etapa2 = document.getElementById('etapa-2') as HTMLFieldSetElement;
    const confirmacao = document.getElementById('confirmacao')!;
    const rotulo = document.getElementById('rotulo-etapa')!;
    const barra2 = document.getElementById('barra-etapa-2')!;
    const textoEtapa1 = rotulo.textContent ?? '';

    const mostrar = (etapa: 1 | 2 | 3) => {
      etapa1.hidden = etapa1.disabled = etapa !== 1;
      etapa2.hidden = etapa2.disabled = etapa !== 2;
      form.hidden = etapa === 3;
      confirmacao.hidden = etapa !== 3;
      rotulo.textContent = etapa === 1 ? textoEtapa1 : etapa === 2 ? form.dataset.etapa2! : form.dataset.concluido!;
      barra2.classList.toggle('bg-ciano', etapa >= 2);
      barra2.classList.toggle('bg-borda', etapa < 2);
    };

    // Valida os campos obrigatórios da etapa e foca no primeiro com erro
    const validar = (etapa: HTMLFieldSetElement) => {
      const campos = Array.from(etapa.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select'));
      const invalido = campos.find((c) => !c.checkValidity());
      if (invalido) {
        invalido.reportValidity();
        invalido.focus();
        return false;
      }
      return true;
    };

    document.getElementById('botao-continuar')!.addEventListener('click', () => {
      if (!validar(etapa1)) return;
      mostrar(2);
      etapa2.querySelector('select')?.focus();
    });

    // Enter na etapa 1 avança em vez de enviar
    etapa1.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT') {
        e.preventDefault();
        document.getElementById('botao-continuar')!.click();
      }
    });

    document.getElementById('botao-voltar')!.addEventListener('click', () => {
      mostrar(1);
      etapa1.querySelector('input')?.focus();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validar(etapa2)) return;
      // Sem envio real por enquanto (destino a definir: Kommo, N8N ou WhatsApp)
      mostrar(3);
      confirmacao.focus();
    });

    document.getElementById('botao-reiniciar')!.addEventListener('click', () => {
      form.reset();
      mostrar(1);
      etapa1.querySelector('input')?.focus();
    });

    // Máscara simples de WhatsApp: (00) 00000-0000
    const whatsapp = form.querySelector<HTMLInputElement>('input[name="whatsapp"]');
    whatsapp?.addEventListener('input', () => {
      const d = whatsapp.value.replace(/\D/g, '').slice(0, 11);
      let v = d;
      if (d.length > 2) v = `(${d.slice(0, 2)}) ${d.slice(2)}`;
      if (d.length > 7) v = `(${d.slice(0, 2)}) ${d.slice(2, d.length - 4)}-${d.slice(-4)}`;
      whatsapp.value = v;
    });
  }
</script>
